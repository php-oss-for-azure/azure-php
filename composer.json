{
  "name": "azure-oss/azure-php",
  "description": "Community-maintained Azure SDKs for PHP",
  "keywords": ["azure", "identity", "storage", "php", "sdk"],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AzureOss\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AzureOss\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Brecht Vermeersch",
      "email": "brechtvermeersch@outlook.be"
    },
    {
      "name": "Pim Jansen",
      "email": "pimjansen@gmail.com"
    }
  ],
  "require-dev": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-simplexml": "*",
    "ext-zlib": "*",
    "brianium/paratest": "^7.8",
    "caseyamcl/guzzle_retry_middleware": "^3.0",
    "guzzlehttp/guzzle": "^8.0",
    "guzzlehttp/test-server": "^1.0",
    "laravel/pint": "1.31.1",
    "league/flysystem-adapter-test-utilities": "^3.28",
    "league/flysystem-bundle": "^3.7",
    "orchestra/testbench": "^11.2",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-arch": "^3.1",
    "php-http/discovery": "^1.20",
    "phpdocumentor/shim": "^3.10",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^2.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpdocumentor/shim": true,
      "phpstan/extension-installer": true
    },
    "platform": {
    }
  },
  "scripts": {
    "docs:api": "cd /tmp && phpdoc --config \"$OLDPWD/phpdoc.dist.xml\""
  }
}
